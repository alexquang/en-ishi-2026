{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "learnomy/course-grid",
    "version": "1.1.0",
    "title": "Course Grid",
    "category": "learnomy",
    "icon": "screenoptions",
    "description": "Display courses in a grid: pick specific courses, a category, or the latest, and choose how many to show and how many columns.",
    "textdomain": "learnomy",
    "attributes": {
        "source": {
            "type": "string",
            "default": "latest"
        },
        "ids": {
            "type": "string",
            "default": ""
        },
        "category": {
            "type": "integer",
            "default": 0
        },
        "count": {
            "type": "integer",
            "default": 6
        },
        "columns": {
            "type": "integer",
            "default": 3
        }
    },
    "supports": {
        "html": false
    },
    "render": "file:./render.php"
}
