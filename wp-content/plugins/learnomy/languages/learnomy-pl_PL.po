#: blocks/course-card/block.json
msgctxt "block description"
msgid "Display a single course card with title, thumbnail, and key details."
msgstr ""
"Wyświetl pojedynczą kartę course z tytułem, miniaturą i kluczowymi "
"szczegółami."

#: blocks/course-catalog/block.json
msgctxt "block description"
msgid "Browse all published courses in a filterable grid."
msgstr "Przeglądaj wszystkie opublikowane courses w filtrowanej siatce."

#: blocks/course-grid/block.json
msgctxt "block description"
msgid ""
"Display courses in a grid: pick specific courses, a category, or the "
"latest, and choose how many to show and how many columns."
msgstr ""
"Wyświetl courses w siatce: wybierz konkretne courses, kategorię lub "
"najnowsze, i wybierz, ile pokazać i ile kolumn."

#: blocks/enrollment-cta/block.json
msgctxt "block description"
msgid "Show an enroll button or an already-enrolled badge for a course."
msgstr "Pokaż przycisk enrollment lub odznakę już zapisaną dla course."

#: blocks/instructor-card/block.json
msgctxt "block description"
msgid "Display an instructor's avatar, name, bio, course count, and rating."
msgstr ""
"Wyświetl awatara instructora, imię i nazwisko, biografię, liczbę courses i "
"rating."

#: blocks/lesson-content/block.json
msgctxt "block description"
msgid "Display the title and content of a single lesson."
msgstr "Wyświetl tytuł i zawartość pojedynczego lesson."

#: blocks/membership-pricing/block.json
msgctxt "block description"
msgid "Display all active membership plans in a pricing table."
msgstr "Wyświetl wszystkie aktywne plany członkowskie w tabeli cen."

#: blocks/my-progress/block.json
msgctxt "block description"
msgid "Show the current user's overall learning stats and courses in progress."
msgstr "Pokaż ogólne statystyki nauki bieżącego użytkownika i courses w toku."

#: blocks/progress-bar/block.json
msgctxt "block description"
msgid "Show a student's completion progress for a specific course."
msgstr "Pokaż postęp ukończenia studenta dla konkretnego course."

#: blocks/quiz/block.json
msgctxt "block description"
msgid "Show a quiz intro with title, description, rules, and a start button."
msgstr "Pokaż intro quizu z tytułem, opisem, regułami i przyciskiem uruchomienia."

#: blocks/student-dashboard/block.json
msgctxt "block description"
msgid "Show a logged-in student's enrolled courses with progress at a glance."
msgstr ""
"Pokaż enrollment courses zalogowanego studenta z postępem na pierwszy rzut "
"oka."

