msgid "Course Progress Bar"
msgstr "Полоса прогресса курса"

#: blocks/progress-bar/block.json
msgctxt "block description"
msgid "Show a student's completion progress for a specific course."
msgstr "Показать прогресс завершения студента для конкретного курса."

#: blocks/quiz/block.json
msgctxt "block title"
msgid "Quiz"
msgstr "Quiz"

#: blocks/quiz/block.json
msgctxt "block description"
msgid "Show a quiz intro with title, description, rules, and a start button."
msgstr ""
"Показать введение quiz с названием, описанием, правилами и кнопкой запуска."

#: blocks/student-dashboard/block.json
msgctxt "block title"
msgid "Student Dashboard"
msgstr "Панель студента"

#: blocks/student-dashboard/block.json
msgctxt "block description"
msgid "Show a logged-in student's enrolled courses with progress at a glance."
msgstr ""
"Показать зарегистрированные курсы авторизованного студента с прогрессом с "
"первого взгляда."

