msgid ""
"Cancel an active membership subscription; access continues until the end of "
"the current billing period."
msgstr ""
"Avbryt en aktiv medlemskapsprenumeration; åtkomsten fortsätter till slutet "
"av den aktuella faktureringsperioden."

