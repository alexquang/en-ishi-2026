msgstr ""
"Hämta en enskild kurs efter ID, inklusive dess status, pris och "
"instruktörsdetaljer."

#: includes/class-abilities.php:251
msgid "Update course fields such as title, description, price, or access type."
msgstr "Uppdatera kursfält såsom titel, beskrivning, pris eller åtkomsttyp."

#: includes/class-abilities.php:312
msgid "Delete Course"
msgstr "Ta bort kurs"

