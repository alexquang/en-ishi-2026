47\u0442\u043e\u0431\u044b \u0441\u043a\u0440\u044b\u0442\u044c \u0431\u043b\u043e\u043a."],"Enter a certificate ID in the block settings to show its verified details.":["\u0412\u0432\u0435\u0434\u0438\u0442\u0435 ID \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u0430 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0431\u043b\u043e\u043a\u0430, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0435\u0433\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u0435 \u0434\u0435\u0442\u0430\u043b\u0438."],"Course Card":["\u041a\u0430\u0440\u0442\u043e\u0447\u043a\u0430 \u043a\u0443\u0440\u0441\u0430"],"The course to feature in this card.":["\u041a\u0443\u0440\u0441 \u0434\u043b\u044f \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0432 \u044d\u0442\u043e\u0439 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0435."],"No courses found. Create a course first, or enter its ID.":["\u041a\u0443\u0440\u0441\u044b \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u044b. \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u043e\u0437\u0434\u0430\u0439\u0442\u0435 \u043a\u0443\u0440\u0441 \u0438\u043b\u0438 \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u0435\u0433\u043e ID."],"Enroll Button":["\u041a\u043d\u043e\u043f\u043a\u0430 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438"],"The course this button enrolls the visitor into.":["\u041a\u0443\u0440\u0441, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u044d\u0442\u0430 \u043a\u043d\u043e\u043f\u043a\u0430 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442 \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u043b\u044f."],"Button text":["\u0422\u0435\u043a\u0441\u0442 \u043a\u043d\u043e\u043f\u043a\u0438"],"Course Progress Bar":["\u041f\u043e\u043b\u043e\u0441\u0430 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0441\u0430 \u043a\u0443\u0440\u0441\u0430"],"Shows the logged-in visitor's progress in this course